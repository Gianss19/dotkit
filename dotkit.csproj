<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>dotkit</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>bbd3ab05-88f5-444c-8e71-d413b5080beb</UserSecretsId>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotkit</ToolCommandName>
    <PackageId>dotkit</PackageId>
    <Version>1.0.0</Version>
    <Authors>dotkit</Authors>
    <Description>CLI tool to install and configure JWT Authentication in ASP.NET Core Web API projects. Installs NuGet packages, creates JwtSettings/JwtService templates, injects authentication in Program.cs, and configures User Secrets.</Description>
    <PackageTags>jwt;authentication;aspnetcore;webapi;cli;tool;dotnet;jwt-bearer</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dotkit/dotkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dotkit/dotkit.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotMake.CommandLine" Version="3.5.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Templates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
